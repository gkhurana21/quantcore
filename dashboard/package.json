{
  "name": "quantcore-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:engine": "QC_ENGINE=1 playwright test",
    "scan:ui": "node scripts/overlap-scan.mjs && node scripts/occlusion-scan.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.12.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  }
}
